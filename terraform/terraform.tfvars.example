# ─────────────────────────────────────────────────────────────────────────────
# Example terraform.tfvars — Copy this to terraform.tfvars and fill in values
# ─────────────────────────────────────────────────────────────────────────────
# cp terraform.tfvars.example terraform.tfvars
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: Your GCP project ID (from `gcloud config get-value project`)
project_id = "resilient-settlement-prod"

# GCP region — default is Mumbai (asia-south1)
# Change if your target users are in a different geography
region = "asia-south1"
zone   = "asia-south1-a"

# Environment label — affects resource naming
# Options: development, staging, production
environment = "production"

# Application name — used as prefix for all resources
app_name = "payment-orchestrator"
