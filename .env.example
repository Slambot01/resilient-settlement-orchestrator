# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_user
DB_PASSWORD=payment_secret
DB_NAME=payment_orchestrator
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PSP Keys (Sandbox/Test)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# API Authentication
# Format: merchantID:apiKey (comma-separated for multiple)
# Legacy format (no colon): treated as admin key with full access
API_KEYS=merchant_abc:sk_test_abc123,merchant_xyz:sk_test_xyz789,dev-admin-key

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Google Cloud Pub/Sub
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_WEBHOOK_TOPIC=webhook-events
PUBSUB_EVENT_TOPIC=payment-state-changes
PUBSUB_SUBSCRIPTION=webhook-processor
PUBSUB_DLQ_TOPIC=webhook-events-dlq
PUBSUB_DLQ_SUBSCRIPTION=webhook-dlq-reader
PUBSUB_MAX_RETRIES=5

# OpenTelemetry Tracing
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:4318
TRACING_SAMPLE_RATE=1.0
