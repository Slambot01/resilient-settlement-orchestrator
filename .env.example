# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_user
DB_PASSWORD=payment_secret
DB_NAME=payment_orchestrator
DB_SSL_MODE=disable
DB_MAX_CONNS=25
