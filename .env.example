# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_user
DB_PASSWORD=payment_secret
DB_NAME=payment_orchestrator
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PSP Keys (Sandbox/Test)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Google Cloud Pub/Sub
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_WEBHOOK_TOPIC=webhook-events
PUBSUB_EVENT_TOPIC=payment-state-changes
PUBSUB_SUBSCRIPTION=webhook-processor
PUBSUB_DLQ_TOPIC=webhook-events-dlq
PUBSUB_DLQ_SUBSCRIPTION=webhook-dlq-reader
PUBSUB_MAX_RETRIES=5
